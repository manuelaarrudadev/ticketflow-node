{
  "name": "ticketflow-node",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ticketflow-node",
      "workspaces": [
        "apps/*"
      ]
    },
    "apps/api": {
      "name": "@ticketflow/api",
      "version": "0.0.0"
    },
    "apps/fakepay": {
      "name": "@ticketflow/fakepay",
      "version": "0.0.0"
    },
    "apps/web": {
      "name": "@ticketflow/web",
      "version": "0.0.0"
    },
    "node_modules/@ticketflow/api": {
      "resolved": "apps/api",
      "link": true
    },
    "node_modules/@ticketflow/fakepay": {
      "resolved": "apps/fakepay",
      "link": true
    },
    "node_modules/@ticketflow/web": {
      "resolved": "apps/web",
      "link": true
    }
  }
}
